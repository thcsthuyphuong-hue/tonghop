rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.uid == "wg7QT6isC2dryLf8rxc6z9lUjNd2"
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    function isStudent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/exam_rooms/$(roomId);
    }

    function participantPath(roomId, uid) {
      return /databases/$(database)/documents/exam_rooms/$(roomId)/participants/$(uid);
    }

    function roomOwnedByTeacher(roomId) {
      return isTeacher()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.hostUid == request.auth.uid;
    }

    // Legacy quiz app.
    // Reading is intentionally public per project requirements.
    match /artifacts/kham-pha-vat-ly-9/public/data/{collection}/{docId} {
      allow get, list: if true;

      // Editing/deleting app data requires the real teacher Firebase Auth session.
      allow update, delete: if isTeacher()
        && (collection in [
          "question_banks", "config", "students_list",
          "quiz_results", "error_reports"
        ]);

      // Teacher can create/import banks, config and student roster.
      allow create: if isTeacher()
        && collection in ["question_banks", "config", "students_list"];

      // Students may submit their own quiz result and report an issue.
      // Scores are still client-calculated; this is not server-side anti-cheat.
      allow create: if isStudent()
        && collection == "quiz_results"
        && request.resource.data.keys().hasAll([
          "name", "school", "sbd", "class", "topic", "score",
          "duration", "mode", "timestamp", "examData", "userAnswers"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "school", "sbd", "class", "topic", "score",
          "duration", "mode", "timestamp", "examData", "userAnswers"
        ])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10
        && request.resource.data.duration is number
        && request.resource.data.duration >= 0
        && request.resource.data.mode in ["practice", "test"]
        && request.resource.data.examData is list
        && request.resource.data.examData.size() <= 100
        && request.resource.data.userAnswers is map;

      allow create: if isStudent()
        && collection == "error_reports"
        && request.resource.data.keys().hasOnly([
          "name", "question", "detail", "image", "timestamp"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 200
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 5000
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 700000
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40;
    }

    // Exam rooms: room metadata and participant/submission views are public by request.
    // The answer key remains private to the authenticated teacher.
    match /exam_rooms/{roomId} {
      function ownsRoom() {
        return isTeacher() && resource.data.hostUid == request.auth.uid;
      }

      allow get, list: if true;

      allow create: if isTeacher()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == "waiting"
        && request.resource.data.keys().hasAll([
          "hostUid", "status", "publicQuestions", "createdAt",
          "readingStartedAt", "examEndsAt", "finishedAt", "durationMinutes"
        ])
        && request.resource.data.keys().hasOnly([
          "hostUid", "hostEmail", "status", "publicQuestions", "createdAt",
          "readingStartedAt", "examEndsAt", "finishedAt", "durationMinutes"
        ])
        && request.resource.data.publicQuestions is list
        && request.resource.data.publicQuestions.size() <= 100
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes >= 1
        && request.resource.data.durationMinutes <= 180;

      allow update: if ownsRoom()
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "readingStartedAt", "examEndsAt", "finishedAt"]);

      allow delete: if false;

      match /participants/{uid} {
        function roomData() {
          return get(roomPath(roomId)).data;
        }

        function ownsThisRoom() {
          return isTeacher() && roomData().hostUid == request.auth.uid;
        }

        allow get, list: if true;

        allow create: if isStudent()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.approved == false
          && request.resource.data.submitted == false
          && request.resource.data.keys().hasOnly([
            "uid", "name", "class", "sbd", "school",
            "approved", "submitted", "joinedAt"
          ])
          && (roomData().status == "waiting"
            || (roomData().status == "reading"
              && roomData().readingStartedAt != null
              && request.time < roomData().readingStartedAt + duration.value(5, "m")));

        allow update: if (ownsThisRoom()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["approved", "approvedAt"]))
          || (isStudent()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["name", "class", "sbd", "school"]))
          || (isStudent()
            && request.auth.uid == uid
            && request.resource.data.submitted == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["submitted", "submittedAt"])
            && exists(/databases/$(database)/documents/exam_rooms/$(roomId)/submissions/$(uid))
            && get(/databases/$(database)/documents/exam_rooms/$(roomId)/submissions/$(uid)).data.state == "submitted"
            && request.resource.data.submittedAt
              == get(/databases/$(database)/documents/exam_rooms/$(roomId)/submissions/$(uid)).data.submittedAt);

        allow delete: if false;
      }

      match /submissions/{uid} {
        function roomData() {
          return get(roomPath(roomId)).data;
        }

        function ownsThisRoom() {
          return isTeacher() && roomData().hostUid == request.auth.uid;
        }

        function approvedParticipant() {
          return exists(participantPath(roomId, uid))
            && get(participantPath(roomId, uid)).data.approved == true;
        }

        allow get, list: if true;

        allow create: if isStudent()
          && request.auth.uid == uid
          && approvedParticipant()
          && roomData().status == "reading"
          && roomData().readingStartedAt != null
          && roomData().examEndsAt != null
          && request.time >= roomData().readingStartedAt + duration.value(5, "m")
          && request.time < roomData().examEndsAt
          && request.resource.data.keys().hasOnly([
            "uid", "answers", "submittedAt", "state"
          ])
          && request.resource.data.uid == uid
          && request.resource.data.answers is map
          && request.resource.data.state == "submitted"
          && request.resource.data.submittedAt == request.time;

        allow update: if ownsThisRoom()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["manualShortScore", "manualScores", "gradeState", "finalScore"]);
        allow delete: if false;
      }

      match /private/{privateDocId} {
        allow get: if roomOwnedByTeacher(roomId);
        allow list: if false;
        allow create, update: if roomOwnedByTeacher(roomId)
          && privateDocId == "answer_key";
        allow delete: if false;
      }

      match /grades/{uid} {
        allow get, list: if true;
        allow create, update: if roomOwnedByTeacher(roomId)
          && request.resource.data.keys().hasOnly([
            "uid", "manualShortScore", "manualScores", "gradeState",
            "finalScore", "updatedAt"
          ]);
        allow delete: if false;
      }
    }

    // All other paths are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
