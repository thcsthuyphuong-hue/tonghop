rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.uid == "wg7QT6isC2dryLf8rxc6z9lUjNd2"
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    function isStudent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/exam_rooms/$(roomId);
    }

    function participantPath(roomId, uid) {
      return /databases/$(database)/documents/exam_rooms/$(roomId)/participants/$(uid);
    }

    function submissionPath(roomId, uid) {
      return /databases/$(database)/documents/exam_rooms/$(roomId)/submissions/$(uid);
    }

    function roomOwnedByTeacher(roomId) {
      return isTeacher()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.hostUid == request.auth.uid;
    }

    // Legacy quiz app.
    match /artifacts/kham-pha-vat-ly-9/public/data/{collection}/{docId} {
      // Question banks, configuration, student lookup, and result summaries
      // are read by the student app or the public leaderboard.
      allow get, list: if collection in [
        "question_banks", "config", "public_quiz_results"
      ] && (isStudent() || isTeacher());

      // Student roster, detailed attempts, and reports are visible only to
      // the teacher.
      allow get, list: if isTeacher()
        && collection in ["students_list", "quiz_results", "error_reports"];

      allow update, delete: if isTeacher()
        && collection in [
          "question_banks", "config", "students_list",
          "quiz_results", "public_quiz_results", "error_reports"
        ];

      allow create: if isTeacher()
        && collection in ["question_banks", "config", "students_list"];

      // Public summaries intentionally contain only the fields used by the
      // public results list and leaderboard.
      allow create: if collection == "public_quiz_results"
        && (isStudent() || isTeacher())
        && request.resource.data.keys().hasAll([
          "name", "school", "sbd", "class", "topic",
          "score", "duration", "mode", "timestamp"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "school", "sbd", "class", "topic",
          "score", "duration", "mode", "timestamp"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 180
        && request.resource.data.sbd is string
        && request.resource.data.sbd.size() <= 40
        && request.resource.data.class is string
        && request.resource.data.class.size() <= 40
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 120
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10
        && request.resource.data.duration is number
        && request.resource.data.duration >= 0
        && request.resource.data.mode in ["practice", "test"]
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40;

      // Full attempts keep the original data required by teacher review.
      allow create: if isStudent()
        && collection == "quiz_results"
        && request.resource.data.keys().hasAll([
          "name", "school", "sbd", "class", "topic", "score",
          "duration", "mode", "timestamp", "examData", "userAnswers"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "school", "sbd", "class", "topic", "score",
          "duration", "mode", "timestamp", "examData", "userAnswers"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 180
        && request.resource.data.sbd is string
        && request.resource.data.sbd.size() <= 40
        && request.resource.data.class is string
        && request.resource.data.class.size() <= 40
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 120
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10
        && request.resource.data.duration is number
        && request.resource.data.duration >= 0
        && request.resource.data.mode in ["practice", "test"]
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40
        && request.resource.data.examData is list
        && request.resource.data.examData.size() <= 100
        && request.resource.data.userAnswers is map
        && request.resource.data.userAnswers.size() <= 100;

      allow create: if isStudent()
        && collection == "error_reports"
        && request.resource.data.keys().hasAll([
          "name", "question", "detail", "image", "timestamp"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "question", "detail", "image", "timestamp"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 200
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 5000
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 700000
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40;
    }

    // Exam rooms. Clients read one room by code; only its Host can list the
    // roster and submissions. A student can read only their own participant
    // record and grade. The answer key is only readable by the room's Host.
    match /exam_rooms/{roomId} {
      function ownsRoom() {
        return roomOwnedByTeacher(roomId);
      }

      allow get: if isStudent() || ownsRoom();
      allow list: if false;

      allow create: if isTeacher()
        && roomId.size() == 6
        && request.resource.data.keys().hasAll([
          "roomCode", "title", "topic", "topicLabel", "hostUid",
          "status", "durationMinutes", "readingMinutes", "publicQuestions",
          "createdAt", "readingStartedAt", "examEndsAt", "finishedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "roomCode", "title", "topic", "topicLabel", "hostUid",
          "status", "durationMinutes", "readingMinutes", "publicQuestions",
          "createdAt", "readingStartedAt", "examEndsAt", "finishedAt"
        ])
        && request.resource.data.roomCode == roomId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 60
        && request.resource.data.topicLabel is string
        && request.resource.data.topicLabel.size() <= 120
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == "waiting"
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 1
        && request.resource.data.durationMinutes <= 180
        && request.resource.data.readingMinutes is int
        && request.resource.data.readingMinutes == 5
        && request.resource.data.publicQuestions is list
        && request.resource.data.publicQuestions.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.readingStartedAt == null
        && request.resource.data.examEndsAt == null
        && request.resource.data.finishedAt == null;

      allow update: if ownsRoom()
        && request.resource.data.hostUid == resource.data.hostUid
        && (
          (
            resource.data.status == "waiting"
            && request.resource.data.status == "reading"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "readingStartedAt", "examEndsAt"])
            && request.resource.data.readingStartedAt == request.time
            && request.resource.data.examEndsAt == null
            && resource.data.readingStartedAt == null
            && resource.data.examEndsAt == null
          )
          ||
          (
            resource.data.status == "reading"
            && resource.data.readingStartedAt is timestamp
            && resource.data.examEndsAt == null
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["examEndsAt"])
            && request.resource.data.examEndsAt is timestamp
            && request.resource.data.examEndsAt
              >= resource.data.readingStartedAt
                + duration.value(resource.data.readingMinutes, "m")
                + duration.value(resource.data.durationMinutes, "m")
                - duration.value(1, "s")
            && request.resource.data.examEndsAt
              <= resource.data.readingStartedAt
                + duration.value(resource.data.readingMinutes, "m")
                + duration.value(resource.data.durationMinutes, "m")
                + duration.value(1, "s")
          )
          ||
          (
            resource.data.status in ["waiting", "reading"]
            && request.resource.data.status == "finished"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "finishedAt"])
            && request.resource.data.finishedAt == request.time
          )
        );

      allow delete: if false;

      match /participants/{uid} {
        function roomData() {
          return get(roomPath(roomId)).data;
        }

        function ownsThisRoom() {
          return roomOwnedByTeacher(roomId);
        }

        function joinsAreOpen() {
          return roomData().status == "waiting"
            || (
              roomData().status == "reading"
              && roomData().readingStartedAt is timestamp
              && request.time
                < roomData().readingStartedAt + duration.value(5, "m")
            );
        }

        function validProfile() {
          return request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
            && request.resource.data.class is string
            && request.resource.data.class.size() > 0
            && request.resource.data.class.size() <= 20
            && request.resource.data.sbd is string
            && request.resource.data.sbd.size() > 0
            && request.resource.data.sbd.size() <= 30
            && request.resource.data.school is string
            && request.resource.data.school.size() > 0
            && request.resource.data.school.size() <= 120;
        }

        function hasSavedSubmission() {
          let submission = get(submissionPath(roomId, uid)).data;
          return submission.uid == uid
            && submission.state == "submitted"
            && submission.submittedAt is timestamp
            && submission.submittedAt <= request.time;
        }

        allow get: if (isStudent() && request.auth.uid == uid) || ownsThisRoom();
        allow list: if ownsThisRoom();

        allow create: if isStudent()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll([
            "uid", "name", "class", "sbd", "school",
            "approved", "submitted", "joinedAt"
          ])
          && request.resource.data.keys().hasOnly([
            "uid", "name", "class", "sbd", "school",
            "approved", "submitted", "joinedAt"
          ])
          && request.resource.data.uid == uid
          && validProfile()
          && request.resource.data.approved == false
          && request.resource.data.submitted == false
          && request.resource.data.joinedAt == request.time
          && joinsAreOpen();

        allow update: if (
            ownsThisRoom()
            && joinsAreOpen()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["approved", "approvedAt"])
            && request.resource.data.approved is bool
            && (
              (request.resource.data.approved == true
                && request.resource.data.approvedAt == request.time)
              || (request.resource.data.approved == false
                && request.resource.data.approvedAt == null)
            )
          )
          || (
            isStudent()
            && request.auth.uid == uid
            && resource.data.submitted == false
            && joinsAreOpen()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["name", "class", "sbd", "school"])
            && validProfile()
          )
          || (
            isStudent()
            && request.auth.uid == uid
            && resource.data.submitted == false
            && request.resource.data.submitted == true
            && request.resource.data.submittedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["submitted", "submittedAt"])
            && hasSavedSubmission()
          );

        allow delete: if false;
      }

      match /submissions/{uid} {
        function roomData() {
          return get(roomPath(roomId)).data;
        }

        function ownsThisRoom() {
          return roomOwnedByTeacher(roomId);
        }

        function approvedParticipant() {
          return exists(participantPath(roomId, uid))
            && get(participantPath(roomId, uid)).data.approved == true;
        }

        function validManualGradeUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "manualShortScore", "manualScores", "gradeState", "finalScore"
              ])
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.state == "submitted"
            && request.resource.data.manualShortScore is number
            && request.resource.data.manualShortScore >= 0
            && request.resource.data.manualShortScore <= 5.01
            && request.resource.data.manualScores is map
            && request.resource.data.manualScores.size() <= 20
            && request.resource.data.gradeState == "graded"
            && request.resource.data.finalScore is number
            && request.resource.data.finalScore >= 0
            && request.resource.data.finalScore <= 10;
        }

        allow get, list: if ownsThisRoom();

        allow create: if isStudent()
          && request.auth.uid == uid
          && approvedParticipant()
          && roomData().status == "reading"
          && roomData().readingStartedAt is timestamp
          && roomData().durationMinutes is int
          && roomData().readingMinutes == 5
          && request.time
            >= roomData().readingStartedAt + duration.value(5, "m")
          && request.time
            < roomData().readingStartedAt
              + duration.value(roomData().readingMinutes, "m")
              + duration.value(roomData().durationMinutes, "m")
          && request.resource.data.keys().hasAll([
            "uid", "answers", "submittedAt", "state"
          ])
          && request.resource.data.keys().hasOnly([
            "uid", "answers", "submittedAt", "state"
          ])
          && request.resource.data.uid == uid
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 100
          && request.resource.data.state == "submitted"
          && request.resource.data.submittedAt == request.time;

        allow update: if ownsThisRoom() && validManualGradeUpdate();
        allow delete: if false;
      }

      match /private/{privateDocId} {
        allow get: if privateDocId == "answer_key"
          && roomOwnedByTeacher(roomId);
        allow list: if false;

        allow create: if privateDocId == "answer_key"
          && roomOwnedByTeacher(roomId)
          && request.resource.data.keys().hasAll(["keys", "createdAt"])
          && request.resource.data.keys().hasOnly(["keys", "createdAt"])
          && request.resource.data["keys"] is map
          && request.resource.data["keys"].size() <= 20
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      match /grades/{uid} {
        function ownsThisRoom() {
          return roomOwnedByTeacher(roomId);
        }

        function validGrade() {
          return request.resource.data.keys().hasAll([
              "uid", "autoScore", "mcqScore", "tfScore",
              "manualShortScore", "manualScores", "finalScore",
              "gradedBy", "gradedAt"
            ])
            && request.resource.data.keys().hasOnly([
              "uid", "autoScore", "mcqScore", "tfScore",
              "manualShortScore", "manualScores", "finalScore",
              "gradedBy", "gradedAt"
            ])
            && request.resource.data.uid == uid
            && request.resource.data.autoScore is number
            && request.resource.data.autoScore >= 0
            && request.resource.data.autoScore <= 5
            && request.resource.data.mcqScore is number
            && request.resource.data.mcqScore >= 0
            && request.resource.data.mcqScore <= 3
            && request.resource.data.tfScore is number
            && request.resource.data.tfScore >= 0
            && request.resource.data.tfScore <= 2
            && request.resource.data.manualShortScore is number
            && request.resource.data.manualShortScore >= 0
            && request.resource.data.manualShortScore <= 5.01
            && request.resource.data.manualScores is map
            && request.resource.data.manualScores.size() <= 20
            && request.resource.data.finalScore is number
            && request.resource.data.finalScore >= 0
            && request.resource.data.finalScore <= 10
            && request.resource.data.gradedBy == request.auth.uid
            && request.resource.data.gradedAt == request.time;
        }

        // Grades are visible only to the Host and the matching student.
        allow get: if ownsThisRoom() || (isStudent() && request.auth.uid == uid);
        allow list: if ownsThisRoom();
        allow create, update: if ownsThisRoom() && validGrade();
        allow delete: if false;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}